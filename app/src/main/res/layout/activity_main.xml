<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="알림지우개" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold"
        android:layout_marginTop="12dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="한 번 터치로 알림창 깔끔하게" android:textColor="#A9A3D9" android:textSize="15sp"/>

    <!-- 업데이트 알림 (새 버전 있을 때만 보임) -->
    <LinearLayout android:id="@+id/update_card" android:visibility="gone"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/update_bg" android:padding="14dp" android:layout_marginTop="16dp">
        <TextView android:id="@+id/update_text" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
        <TextView android:id="@+id/btn_update" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="설치" android:textColor="#2A1A6B" android:textSize="14sp" android:textStyle="bold"
            android:background="@drawable/chip_white" android:paddingLeft="16dp" android:paddingRight="16dp"
            android:paddingTop="8dp" android:paddingBottom="8dp" android:clickable="true"/>
    </LinearLayout>

    <!-- 큰 지우기 버튼 -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:layout_marginBottom="24dp">
        <LinearLayout android:id="@+id/btn_clear"
            android:layout_width="190dp" android:layout_height="190dp" android:layout_gravity="center"
            android:background="@drawable/big_btn_bg" android:orientation="vertical" android:gravity="center"
            android:clickable="true" android:focusable="true" android:elevation="8dp">
            <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_clear"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="지금 지우기" android:textColor="#FFFFFF" android:textSize="17sp"
                android:textStyle="bold" android:layout_marginTop="6dp"/>
        </LinearLayout>
    </FrameLayout>

    <!-- 권한 카드 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/card_bg" android:padding="18dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="권한" android:textColor="#9F8CFF" android:textSize="13sp" android:textStyle="bold"/>
        <LinearLayout android:id="@+id/row_access" android:layout_width="match_parent" android:layout_height="52dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:clickable="true">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="🔔  알림 접근" android:textColor="#FFFFFF" android:textSize="16sp"/>
            <TextView android:id="@+id/status_access" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="6dp" android:paddingBottom="6dp"
                android:textColor="#FFFFFF" android:textSize="13sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/row_overlay" android:layout_width="match_parent" android:layout_height="52dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:clickable="true">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="🫧  다른 앱 위에 표시" android:textColor="#FFFFFF" android:textSize="16sp"/>
            <TextView android:id="@+id/status_overlay" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="6dp" android:paddingBottom="6dp"
                android:textColor="#FFFFFF" android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 고정 알림 숨기기 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/card_bg" android:padding="18dp"
        android:layout_marginTop="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="📌  고정 알림도 숨기기" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"/>
            <Switch android:id="@+id/sw_persistent" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:thumbTint="#FFFFFF" android:trackTint="#9F8CFF"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="#A9A3D9" android:textSize="13sp" android:lineSpacingExtra="2dp"
            android:text="모아라인 실행중, '앱 위에 표시 중' 같은 지워지지 않는 알림을 12시간 숨겨요.\n앱은 계속 정상 작동하고, 새 콜 알림은 그대로 떠요."/>
        <TextView android:id="@+id/btn_restore" android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="12dp" android:gravity="center" android:clickable="true"
            android:background="@drawable/btn_outline" android:text="↩  숨긴 고정 알림 되돌리기"
            android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
    </LinearLayout>

    <!-- 플로팅 버튼 카드 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/card_bg" android:padding="18dp"
        android:layout_marginTop="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="플로팅 버튼" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
            <Switch android:id="@+id/sw_overlay" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:thumbTint="#FFFFFF" android:trackTint="#9F8CFF"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="#A9A3D9" android:textSize="13sp" android:lineSpacingExtra="2dp"
            android:text="탭 → 알림 지우기\n드래그 → 위치 이동 (가장자리에 붙음)\n아래 ✕ 로 끌어다 놓기 → 끄기"/>

        <FrameLayout android:layout_width="match_parent" android:layout_height="110dp"
            android:layout_marginTop="14dp" android:background="@drawable/preview_bg">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="top|start" android:layout_margin="10dp"
                android:text="미리보기" android:textColor="#CCFFFFFF" android:textSize="11sp"/>
            <FrameLayout android:id="@+id/preview_bubble" android:layout_width="56dp" android:layout_height="56dp"
                android:layout_gravity="center" android:background="@drawable/bubble_bg" android:elevation="6dp"
                android:padding="12dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_clear"/>
            </FrameLayout>
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="16dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="투명도" android:textColor="#FFFFFF" android:textSize="15sp"/>
            <TextView android:id="@+id/alpha_val" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#C2ADFF" android:textSize="15sp" android:textStyle="bold"/>
        </LinearLayout>
        <SeekBar android:id="@+id/seek_alpha" android:layout_width="match_parent" android:layout_height="40dp"
            android:progressTint="#9F8CFF" android:thumbTint="#FFFFFF" android:progressBackgroundTint="#55FFFFFF"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="6dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="크기" android:textColor="#FFFFFF" android:textSize="15sp"/>
            <TextView android:id="@+id/size_val" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#C2ADFF" android:textSize="15sp" android:textStyle="bold"/>
        </LinearLayout>
        <SeekBar android:id="@+id/seek_size" android:layout_width="match_parent" android:layout_height="40dp"
            android:progressTint="#9F8CFF" android:thumbTint="#FFFFFF" android:progressBackgroundTint="#55FFFFFF"/>
    </LinearLayout>

    <!-- 위젯 안내 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/card_bg" android:padding="18dp"
        android:layout_marginTop="14dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="홈화면 위젯" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="#A9A3D9" android:textSize="13sp"
            android:text="홈화면 길게 누르기 → 위젯 → 알림지우개 → '알림 지우기' 추가\n※ 화면공유·음악·배달앱 실행중 같은 고정 알림은 안드로이드 정책상 지울 수 없어요"/>
    </LinearLayout>

    <TextView android:id="@+id/ver_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:layout_marginBottom="24dp"
        android:textColor="#6E68A0" android:textSize="12sp"/>
</LinearLayout>
</ScrollView>
